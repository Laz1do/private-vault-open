{
  "manifest_version": 3,
  "name": "私密密码库 · 浏览器助手",
  "version": "0.3.1",
  "description": "连接本机私密密码库：选择账号填写，在小窗确认保存或更新。",
  "minimum_chrome_version": "106",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "私密密码库", "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "content_security_policy": { "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; connect-src 'none'" }
}
